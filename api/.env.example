# Copiar para .env e preencher. O ficheiro .env nunca vai para o Git.

PORT=3000

# --- Base de dados -----------------------------------------------------------
# Local:
#   mongodb://127.0.0.1:27017/do-campo-a-mesa
#
# MongoDB Atlas, formato SRV (o que o Atlas mostra por omissão):
#   mongodb+srv://<utilizador>:<password>@<cluster>/do-campo-a-mesa?retryWrites=true&w=majority
#
# Atenção: o formato SRV precisa de uma consulta DNS do tipo SRV, e há redes que
# não a respondem — routers domésticos antigos, redes de empresa e, sobretudo,
# hotspots de telemóvel. Nesse caso o arranque falha com
# "querySrv EBADRESP". A solução é usar o formato clássico, que o Atlas também
# dá em Connect -> Drivers -> "Legacy URI String" e que só precisa de registos
# DNS normais:
#   mongodb://<utilizador>:<password>@<no1>:27017,<no2>:27017,<no3>:27017/do-campo-a-mesa?ssl=true&replicaSet=<nome>&authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/do-campo-a-mesa

# --- Segurança ---------------------------------------------------------------
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio
JWT_EXPIRA=8h

# Origens autorizadas a chamar a API.
# Em desenvolvimento deixar vazio ou '*'; em produção o endereço da SPA.
CORS_ORIGIN=*
